{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch(domain:*.github.com)",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__pull_request_read",
      "Read(~/.claude/settings.voicevox.json)",
      "Read(**/.claude/settings.voicevox.json)",
      "Read(**/voicevox/speakers/*.json)",
      "Read(~/.claude/**)",
      "Read(**/.claude/**)",
      "mcp__plugin_voicevox_voicevox__*",
      "mcp__todoist__*",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_wait_for"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(.env)"
    ],
    "ask": [
      "WebFetch(domain:*)",
      "Bash(git push:*)",
      "Bash(git revert:*)",
      "Read(**/*key*)",
      "Read(**/*token*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "mcp__github__add_*",
      "mcp__github__assign_*",
      "mcp__github__create_*",
      "mcp__github__delete_*",
      "mcp__github__fork_*",
      "mcp__github__merge_*",
      "mcp__github__push_*",
      "mcp__github__pull_request_review_write",
      "mcp__github__remove_*",
      "mcp__github__reprioritize_*",
      "mcp__github__request_*",
      "mcp__github__update_*"
    ]
  },
  "model": "sonnet",
  "enabledPlugins": {
    "voicevox@claude-voicevox-plugin": true
  },
  "extraKnownMarketplaces": {
    "claude-voicevox-plugin": {
      "source": {
        "source": "github",
        "repo": "n-ngm/claude-voicevox-plugin"
      }
    }
  },
  "language": "Japanese",
  "feedbackSurveyRate": 0,
  "effortLevel": "high",
  "tui": "fullscreen"
}
